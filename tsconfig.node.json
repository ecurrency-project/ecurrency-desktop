{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    // Web Crypto types (CryptoKey, SubtleCrypto, crypto.subtle) used by the
    // crypto package and the vault live in the DOM lib. The Electron main process
    // (Node 24 in Electron 41) exposes these as runtime globals, so declaring
    // them here describes the real environment — it is not a polyfill.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["electron-vite/node", "node"]
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*"
  ]
}
