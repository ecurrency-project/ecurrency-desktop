{
  "name": "qbitcoin-wallet-desktop",
  "version": "1.0.1",
  "private": true,
  "description": "Desktop wallet for the post-quantum QBitcoin (QBT) network. Multibrand common base.",
  "license": "Apache-2.0",
  "author": "QBitcoin",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "electron-vite build && playwright test",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:mac:test": "electron-vite build && electron-builder --mac --config electron-builder.test.yml"
  },
  "dependencies": {
    "@qbitcoin/vault": "workspace:*",
    "@qbtc/chain": "1.1.0",
    "@qbtc/crypto": "1.1.0",
    "electron-updater": "^6.3.9",
    "qrcode.react": "4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@noble/hashes": "1.7.1",
    "@playwright/test": "1.60.0",
    "@types/node": "22.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "41.8.0",
    "electron-builder": "26.15.5",
    "electron-vite": "5.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.61.1",
    "vite": "7.3.5",
    "vitest": "3.2.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
